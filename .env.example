# ---- Azure DevOps (PAT: Work Items -> Read) ------------------------------
# Create the PAT at https://dev.azure.com/YOUR_ORG/_usersSettings/tokens
# with Scopes = Custom defined -> Work Items -> Read. See README
# ("Getting the ADO personal access token") for the full walkthrough.
ADO_ORG_URL=https://dev.azure.com/YOUR_ORG
ADO_PROJECT=YOUR_PROJECT
ADO_AREA_PATH=YOUR_PROJECT\Your Team\Sub Team
ADO_PAT=your_personal_access_token_here

# Optional: restrict to a sprint. Use @current to auto-detect the sprint
# containing today's date, or hardcode a path (UNDER match).
# ADO_ITERATION_PATH=@current
# ADO_ITERATION_PATH=YOUR_PROJECT\Q2FY27 Sprint 1

# Optional filters
# ADO_WORK_ITEM_TYPES=Task,Bug,User Story,Product Backlog Item
# ADO_EXCLUDE_STATES=Closed,Done,Removed,Resolved,Completed

# ---- Staleness threshold (days without an update) ------------------------
STALE_DAYS=7

# ---- People to track (CSV of emails) -------------------------------------
# Only items assigned to these people are flagged (unassigned ignored).
# Leave blank to track everyone.
# TRACK_PEOPLE=alice@contoso.com,bob@contoso.com
TRACK_PEOPLE=

# ---- Email (delegated Graph, sent as you via WAM broker) -----------------
# Your Entra tenant id (GUID). Omit to use "organizations", which works for
# any work/school account.
# TENANT_ID=00000000-0000-0000-0000-000000000000
# Public-client app id for broker sign-in. Default = Azure CLI first-party
# client. If Mail.Send consent is blocked for it, register a public client
# with delegated Mail.Send + User.Read and put its id here.
# GRAPH_CLIENT_ID=04b07795-8ddb-461a-bbee-02f9e1bf7b46
MAIL_SUBJECT_PREFIX=[ADO Reminder]
# CC every reminder to yourself / a team lead (optional, CSV)
MAIL_CC=you@example.com
# Where unassigned items go if you choose to send them (optional)
MAIL_FALLBACK_TO=you@example.com
